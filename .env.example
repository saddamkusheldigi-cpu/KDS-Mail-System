# ==========================================
# APP & SECURITY CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InboxMailer"
ADMIN_API_KEY="dev-secret-key-change-in-production"
UNSUBSCRIBE_HMAC_SECRET="super-secret-hmac-key-for-signing-unsubscribe-tokens"

# ==========================================
# MAIL SMTP CREDENTIALS (AMAZON SES OR CUSTOM SMTP)
# ==========================================
# Amazon SES SMTP Endpoint (ap-south-1 Mumbai: email-smtp.ap-south-1.amazonaws.com)
# Ya koi bhi standard SMTP provider (Gmail, Zoho, SendGrid, Brevo, custom)
SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="AKIAxxxxxxxxxxxxxxxx"       # SES SMTP Username ya email
SMTP_PASS="BMxxxxxxxxxxxxxxxxxxxxxxx"   # SES SMTP Password ya App Password

# ==========================================
# AWS CREDENTIALS & SQS QUEUE (ap-south-1 Mumbai)
# ==========================================
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
SQS_DISPATCH_QUEUE_URL="https://sqs.ap-south-1.amazonaws.com/123456789012/email-dispatch-queue"

# ==========================================
# VERIFIED SENDER IDENTITIES
# ==========================================
DEFAULT_SENDER_INFO="info@yourdomain.com"
DEFAULT_SENDER_SALES="sales@yourdomain.com"
SES_CONFIGURATION_SET="bulk-mailer-config-set"

# ==========================================
# LOCAL TESTING / DEV MOCK FLAGS
# ==========================================
# Set to 'false' jab real SMTP credentials se email bhejni ho
MOCK_SES="false"

# Rate Limiting & Throttle Jitter (in Milliseconds)
MIN_DELAY_MS="30000"
MAX_DELAY_MS="45000"
